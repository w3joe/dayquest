# Server-side only. Never use NEXT_PUBLIC_ for credentials.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
BLOB_READ_WRITE_TOKEN=
# Public base URL of the Blob store used by B for days/<id>/day.json
BLOB_BASE_URL=
# B pipeline. Default is mock (placeholder art, no API calls). Set to "live" to spend credits.
PIPELINE_TEXT=mock
PIPELINE_IMAGES=mock
OPENAI_TEXT_MODEL=gpt-6-astra
# World-design agents. live = Cloud Agents API (one hosted sandbox/VM per specialist).
# sdk = in-process Agents SDK. template or off = no agent calls.
# Needs api.agents.read + api.agents.write on the API key, plus api.responses.write.
WORLD_DESIGN_AGENTS=live
# Optional extra hostnames/IPs for development from another device (comma separated, no port).
DAYQUEST_DEV_ORIGINS=
