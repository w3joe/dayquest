# Server-side only. Never use NEXT_PUBLIC_ for credentials.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
BLOB_READ_WRITE_TOKEN=
# Public base URL of the Blob store used by B for days/<id>/day.json
BLOB_BASE_URL=
# B pipeline. Default is mock (placeholder art, no API calls). Set to "live" to spend credits.
PIPELINE_TEXT=mock
PIPELINE_IMAGES=mock
OPENAI_TEXT_MODEL=gpt-5.4-mini
# Optional extra hostnames/IPs for development from another device (comma separated, no port).
DAYQUEST_DEV_ORIGINS=
